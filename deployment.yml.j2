---
# k8s/deployment.yml.j2
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mon-app
  namespace: {{ k8s_namespace }}
  labels:
    app: mon-app
spec:
  replicas: 3
  selector:
    matchLabels:
      app: mon-app
  template:
    metadata:
      labels:
        app: mon-app
      annotations:
        # Prometheus va scraper les métriques sur /metrics port 5000
        prometheus.io/scrape: "true"
        prometheus.io/port:   "5000"
        prometheus.io/path:   "/metrics"
    spec:
      containers:
        - name: mon-app
          image: {{ image_name }}:{{ image_tag }}
          ports:
            - containerPort: 5000
          resources:
            requests:
              cpu:    "100m"
              memory: "128Mi"
            limits:
              cpu:    "250m"
              memory: "256Mi"
          livenessProbe:
            httpGet:
              path: /health
              port: 5000
            initialDelaySeconds: 15
            periodSeconds:       20
          readinessProbe:
            httpGet:
              path: /health
              port: 5000
            initialDelaySeconds: 5
            periodSeconds:       10
